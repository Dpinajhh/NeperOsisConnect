# ============================================================
#  Osis Connect - contoh konfigurasi PRODUKSI
# ============================================================
#
#  Cara pakai:
#    1. salin file ini menjadi .env  (cp .env.production.example .env)
#    2. php artisan key:generate      (WAJIB: buat APP_KEY baru, jangan
#                                      pakai kunci pengembangan)
#    3. isi DB_*, MAIL_*, APP_URL, dan ADMIN_* di bawah
#    4. php artisan migrate --force --seed
#       Di APP_ENV=production seeder otomatis memakai ProduksiSeeder:
#       hanya jurusan/kelas/kategori/topik + akun admin dari ADMIN_*.
#       Akun uji berpassword "password" TIDAK dibuat.
#    5. hapus ADMIN_PASSWORD dari .env setelah akun admin siap
#    6. php artisan storage:link
#    7. npm ci && npm run build
#    8. php artisan optimize          (cache config/route/view)
#
#  Panduan lengkap: DEPLOY.md
#  Jangan pernah commit file .env yang sudah terisi.
# ============================================================

APP_NAME="Osis Connect"

# Produksi: jangan pakai "local"
APP_ENV=production

# Diisi oleh `php artisan key:generate`
APP_KEY=

# WAJIB false di produksi - kalau true, pesan error menampilkan
# stack trace, isi query, sampai kredensial database ke pengunjung.
APP_DEBUG=false

# URL publik aplikasi (harus https)
APP_URL=https://osisconnect.sekolah.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: jangan "debug" agar log tidak membengkak & tidak memuat data sensitif
LOG_LEVEL=warning

# ---- Akun admin awal (dipakai ProduksiSeeder) --------------
# Hanya untuk instalasi baru. Minimal 8 karakter.
# Setelah admin berhasil dibuat: kosongkan ADMIN_PASSWORD.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Database (MySQL) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osis_connect
DB_USERNAME=osis_connect
DB_PASSWORD=

# ---- Sesi & cookie -----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB true bila situs sudah HTTPS: cookie sesi tidak dikirim lewat
# koneksi HTTP polos (mencegah pembajakan sesi di jaringan sekolah/wifi).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=osisconnect

# ---- Email (reset kata sandi) ------------------------------
# Pilihan: smtp (mis. Gmail sekolah), ses, atau mailgun/postmark.
# MAIL_MAILER=log berarti tautan reset HANYA ditulis ke log, tidak terkirim.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@osisconnect.sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
